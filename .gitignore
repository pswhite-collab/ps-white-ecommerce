# ============================================================
# ROOT .gitignore — ps-white-ecommerce (LEAK-PROOF HARDENED)
# ============================================================

# --- Dependencies ---
node_modules/
frontend/node_modules/
backend/node_modules/

# --- Environment Files (CRITICAL: never commit secrets) ---
.env
.env.local
.env.production
.env.development
.env.staging
.env.test
*.env
.env.*
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*

# --- Build Artifacts ---
frontend/dist/
frontend/build/
backend/dist/
backend/build/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/*.log
backend/*.err.log
backend/*.out.log

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db

# --- Testing ---
coverage/
.nyc_output/

# --- Misc ---
*.pem
*.key
*.cert
